{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qwap-qms-testnet-swapper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "QMS_RPC_URL": "https://rpc.testnet.qms.finance",
    "QMS_CHAIN_ID": 19480,
    "QWAP_ROUTER": "0x93AFF45f28e5DF1b55f5AEFEfB807De843b12619",
    "WQMS": "0x9AA510295aC664A3d5A3182a3eFe959DE2B12c34",
    "USDC": "0xDfF68E53a0A8275212927c12017f5aB5f1842a04",
    "SWAP_QMS": "0.5",
    "QMS_RESERVE": "0.5",
    "SLIPPAGE_BPS": "500",
    "TX_DEADLINE_SECONDS": "180",
    "USDC_DUST": "1"
  }
}
